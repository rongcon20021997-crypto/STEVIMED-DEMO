# Supabase dashboard → Project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# SERVER ONLY. Add to Vercel Environment Variables, never prefix NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# OPTIONAL: enables structured Vietnamese text parsing; deterministic matcher works without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Production opt-in: bật đồng nghĩa mọi khách truy cập website có thể đọc/sửa/duyệt dữ liệu
RND_ALLOW_PUBLIC_ACCESS=false
